---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.id.localeCompare(a.id));

const CATS: Record<string, string> = {
  'small-spaces': 'Small Spaces',
  'kitchen': 'Kitchen',
  'closet-organization': 'Closet',
  'storage-ideas': 'Storage',
  'decorating': 'Decorating',
};
const catLabel = (c?: string) => CATS[c ?? ''] ?? 'Guides';
const readTime = (body?: string) => Math.max(3, Math.round((body ?? '').split(/\s+/).length / 200));
---
<Layout title="Small Space Organization Ideas for Real Homes" description="My Sorted Nest — practical home organization ideas for small apartments: pantry systems, closet organization, kitchen storage and clever hacks. New guides weekly.">
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "My Sorted Nest",
  "url": "https://mysortednest.life",
  "description": "Practical home organization ideas for small apartments."
})} />

<section class="py-space-lg lg:py-space-xl">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
<!-- Left Column: Editorial Headline & Actions -->
<div class="lg:col-span-6 flex flex-col justify-center pr-0 lg:pr-space-md">
<div class="inline-flex items-center gap-space-xs mb-space-sm">
<span class="w-2 h-2 rounded-full bg-primary"></span>
<span class="font-label-caps text-label-caps uppercase tracking-widest text-primary">A Better Home Starts Here</span>
</div>
<h1 class="font-display-hero text-display-hero text-on-surface mb-space-md leading-tight">
          Make Room for the Life You Love.
        </h1>
<p class="font-body-lead text-body-lead text-on-surface-variant mb-space-lg max-w-xl">
          Smart storage, beautiful spaces, and practical ideas to make every corner of your home work harder.
        </p>
<div class="flex flex-wrap items-center gap-y-space-sm">
<a class="inline-flex items-center justify-center bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container px-7 py-3.5 rounded-lg font-label-regular text-label-regular tracking-wide transition-colors" href="/categories/small-spaces/">
            Explore Small-Space Ideas
          </a>
<a class="font-label-regular text-label-regular text-on-surface hover:text-secondary ml-6 transition-colors inline-flex items-center gap-space-xs group" href="/blog/">
            Browse All Articles <span class="transition-transform group-hover:translate-x-1">→</span>
</a>
</div>
<!-- Curated Stats Strip -->
<div class="grid grid-cols-3 gap-gutter pt-space-lg mt-space-lg bg-surface-container-low p-space-md rounded-xl">
<div class="flex flex-col">
<span class="font-title-editorial text-title-editorial text-on-surface font-semibold">Weekly</span>
<span class="font-body-compact text-body-compact text-on-surface-variant">Fresh Guides</span>
</div>
<div class="flex flex-col">
<span class="font-title-editorial text-title-editorial text-on-surface font-semibold">5</span>
<span class="font-body-compact text-body-compact text-on-surface-variant">Room Categories</span>
</div>
<div class="flex flex-col">
<span class="font-title-editorial text-title-editorial text-on-surface font-semibold">Zero</span>
<span class="font-body-compact text-body-compact text-on-surface-variant">Clutter Mindset</span>
</div>
</div>
</div>
<!-- Right Column: High-Res Editorial Photography -->
<div class="lg:col-span-6 relative mt-space-md lg:mt-0">
<div class="relative overflow-hidden rounded-xl bg-surface-container aspect-[4/3] lg:aspect-[1/1] shadow-md group">
<img class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]" alt="Sunlit minimalist Scandinavian studio apartment with a light linen sofa, warm oak open shelves displaying speckled ceramic bowls and olive branches, integrated kitchen with fluted wooden cabinetry, natural jute rug on pale ash timber flooring, warm gentle morning light, calm architectural interior photography" src="/images/hero-home.jpg"/>
<div class="absolute bottom-4 left-4 right-4 bg-surface/90 backdrop-blur-md p-space-sm rounded-lg flex items-center justify-between">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary text-[20px]">chair</span>
<div>
<p class="font-label-caps text-label-caps uppercase text-on-surface">The Small-Space Pantry</p>
<p class="font-body-compact text-body-compact text-on-surface-variant">21 ideas, zero renovations</p>
</div>
</div>
<a href="/blog/small-apartment-pantry-organization-ideas/" class="font-label-caps text-label-caps text-secondary uppercase font-semibold">Read the Guide →</a>
</div>
</div>
</div>
</div>
</section>


<section class="py-space-xl">
