</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-gutter">
{posts.map((post) => (
<article class="flex flex-col bg-surface-container-lowest rounded-xl p-space-sm shadow-sm hover:shadow-md transition-all group">
<div class="aspect-[16/10] rounded-lg overflow-hidden bg-surface-container mb-space-sm relative">
<a href={`/blog/${post.id.replace(/\.md$/, '')}/`}><img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={post.data.image} alt={post.data.title} loading="lazy"/></a>
<span class="absolute top-2.5 left-2.5 bg-surface/90 px-2 py-0.5 rounded-full font-label-caps text-label-caps text-on-surface">{catLabel(post.data.category)}</span>
</div>
<div class="flex items-center gap-space-xs text-on-surface-variant font-body-compact text-body-compact mb-1">
<span>{post.data.pubDate}</span><span>·</span><span>{readTime(post.body)} min read</span>
